# Managed-by: keepalivehd-ubuntu
[Unit]
Description=KeepAliveHD controller (HDD keepalive, schedule and dashboard)
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
# Root is needed for raw block-device reads and SMART pass-through (SG_IO).
ExecStart=/usr/bin/python3 -u /opt/keepalivehd/app.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=15
Nice=10

RuntimeDirectory=keepalivehd
RuntimeDirectoryMode=0755
StateDirectory=keepalivehd
StateDirectoryMode=0750
ConfigurationDirectory=keepalivehd
ConfigurationDirectoryMode=0750

# Sandboxing: the service can only write its own config/state directories.
ProtectSystem=strict
ReadWritePaths=/etc/keepalivehd /var/lib/keepalivehd
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
